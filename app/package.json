{
  "name": "dcs2streamdeck-app",
  "productName": "dcs2streamdeck",
  "version": "0.4.2",
  "private": true,
  "description": "dcs2streamdeck desktop app, one portable zip per aircraft: drives the Stream Deck directly, no Elgato app needed.",
  "author": "Adam Chesters",
  "main": "dist-electron/main.cjs",
  "devDependencies": {
    "@elgato-stream-deck/webhid": "7.8.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "scripts": {
    "build": "vite build && node build-main.mjs",
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/*.test.ts\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && node dist.mjs"
  },
  "build": {
    "copyright": "Adam Chesters",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  }
}
