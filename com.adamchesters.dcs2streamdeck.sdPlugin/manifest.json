{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "dcs2streamdeck F/A-18C",
	"Version": "0.1.8.0",
	"Author": "Adam Chesters",
	"Description": "Control the DCS World F/A-18C Hornet from your Stream Deck through DCS-BIOS, with live switch, light and knob state.",
	"UUID": "com.adamchesters.dcs2streamdeck",
	"Category": "dcs2streamdeck F/A-18C",
	"CategoryIcon": "imgs/category",
	"Icon": "imgs/plugin",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"Actions": [
		{
			"Name": "DCS Switch",
			"UUID": "com.adamchesters.dcs2streamdeck.switch",
			"Icon": "imgs/switch",
			"Tooltip": "Sends a cockpit command and shows the switch state from DCS.",
			"PropertyInspectorPath": "ui/switch.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/key",
					"ShowTitle": true
				}
			],
			"SupportedInMultiActions": true
		},
		{
			"Name": "DCS Light",
			"UUID": "com.adamchesters.dcs2streamdeck.light",
			"Icon": "imgs/light",
			"Tooltip": "Shows a cockpit light or indicator: caution lights, L BAR, AOA indexer, flaps, gear.",
			"PropertyInspectorPath": "ui/light.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/key"
				}
			],
			"SupportedInMultiActions": false
		},
		{
			"Name": "DCS Dial",
			"UUID": "com.adamchesters.dcs2streamdeck.dial",
			"Icon": "imgs/dial",
			"Tooltip": "Turn to adjust a cockpit knob. Press to step to the next knob.",
			"PropertyInspectorPath": "ui/dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust",
					"Push": "Next knob",
					"Touch": "Next knob"
				}
			},
			"States": [
				{
					"Image": "imgs/key"
				}
			]
		}
	]
}