{
  "name": "dcs2streamdeck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#aircraft": {
      "fa18c": "./aircraft/fa18c/aircraft.ts",
      "f16c": "./aircraft/f16c/aircraft.ts",
      "default": "./aircraft/fa18c/aircraft.ts"
    }
  },
  "scripts": {
    "build": "node plugin/build.mjs",
    "check": "tsc --noEmit && tsc --noEmit --customConditions node,f16c",
    "test": "node plugin/build.mjs && node tools/test.mjs",
    "pack": "node plugin/build.mjs --pack",
    "sim": "node tools/fake-dcs.ts",
    "record": "node tools/record.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "@elgato/utils": "0.6.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
